* {
  box-sizing: border-box;
}

:root {
  --bg: #0b0d10;
  --bg-soft: #111418;
  --panel: rgba(20, 23, 27, 0.9);
  --panel-strong: #171b1f;
  --panel-rim: rgba(255, 255, 255, 0.04);
  --text: #edf3f7;
  --muted: #a0acb7;
  --line: rgba(255, 255, 255, 0.08);
  --red: #b10f1a;
  --red-strong: #c1121f;
  --red-soft: #7d0d16;
  --orange: #e76f51;
  --shadow: rgba(0, 0, 0, 0.38);
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  background:
    radial-gradient(circle at top, rgba(177, 15, 26, 0.18), transparent 28%),
    linear-gradient(180deg, #090b0d 0%, #111315 100%);
  color: var(--text);
  font-family: "Inter", sans-serif;
  line-height: 1.6;
}

a {
  color: inherit;
  text-decoration: none;
}

img {
  max-width: 100%;
  display: block;
}

.container {
  width: min(1120px, calc(100% - 2rem));
  margin: 0 auto;
}

.topbar {
  position: sticky;
  top: 0;
  z-index: 20;
  background: rgba(11, 13, 16, 0.9);
  border-bottom: 1px solid var(--line);
  backdrop-filter: blur(12px);
}

.nav-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 72px;
  gap: 1rem;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  font-weight: 800;
  letter-spacing: 0.04em;
}

.brand-mark {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 42px;
  min-width: 42px;
  padding: 0.35rem 0.6rem;
  border-radius: 12px;
  background: linear-gradient(135deg, var(--red-strong), var(--red-soft));
  box-shadow: 0 10px 25px rgba(193, 18, 31, 0.35);
  font-size: 0.9rem;
  letter-spacing: 0.08em;
}

.brand-text {
  font-size: 0.86rem;
  text-transform: uppercase;
}

.nav {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: flex-end;
  gap: 1rem;
  font-size: 0.88rem;
  color: var(--muted);
}

.nav a {
  transition: color 0.2s ease;
}

.nav a:hover,
.nav a:focus-visible {
  color: var(--text);
}

.hero {
  padding: 5rem 0 3rem;
}

.hero-grid {
  display: grid;
  grid-template-columns: 1.4fr 0.8fr;
  gap: 2rem;
  align-items: center;
}

.eyebrow {
  margin: 0 0 0.9rem;
  color: #ffb1a9;
  text-transform: uppercase;
  font-size: 0.76rem;
  letter-spacing: 0.14em;
  font-weight: 700;
}

h1,
h2,
h3 {
  margin: 0;
  line-height: 1.12;
}

h1 {
  font-size: clamp(2.8rem, 6vw, 5rem);
  letter-spacing: -0.06em;
}

h2 {
  font-size: clamp(2rem, 4vw, 3rem);
  letter-spacing: -0.04em;
}

h3 {
  font-size: 1.35rem;
  letter-spacing: -0.03em;
}

.tagline {
  margin: 0.85rem 0 1rem;
  color: #f5c2b7;
  font-weight: 700;
  font-size: clamp(1.2rem, 2vw, 1.5rem);
}

.lead,
.section-copy,
.mission-card p,
.division-card p,
.leader-card p,
.application-card p,
.announcement-item p,
.discord-copy p {
  color: var(--muted);
}

.lead {
  max-width: 62ch;
  margin: 0;
  font-size: 1.02rem;
}

.cta-group {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 1.6rem;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  padding: 0.85rem 1.4rem;
  border-radius: 12px;
  border: 1px solid transparent;
  font-weight: 700;
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.btn:hover,
.btn:focus-visible {
  transform: translateY(-1px);
}

.btn-primary {
  background: linear-gradient(135deg, var(--red), var(--red-soft));
  box-shadow: 0 12px 30px rgba(193, 18, 31, 0.35);
}

.btn-secondary {
  background: transparent;
  border-color: var(--line);
}

.hero-stats {
  list-style: none;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1rem;
  padding: 0;
  margin: 2rem 0 0;
}

.hero-stats li {
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.hero-stats strong {
  font-size: 1.45rem;
}

.hero-stats span {
  color: var(--muted);
  font-size: 0.8rem;
}

.hero-panel {
  background: linear-gradient(180deg, rgba(18, 21, 25, 0.9), rgba(12, 14, 17, 0.98));
  border: 1px solid var(--line);
  border-radius: 24px;
  box-shadow: 0 24px 60px var(--shadow);
  overflow: hidden;
}

.panel-header,
.panel-footer,
.status-row,
.application-row,
.discord-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}

.panel-header,
.panel-footer {
  padding: 1rem 1.25rem;
  border-bottom: 1px solid var(--line);
  background: rgba(255, 255, 255, 0.02);
}

.panel-body {
  padding: 1.1rem 1.25rem 0.5rem;
}

.status-row {
  padding: 0.9rem 0;
  border-bottom: 1px solid var(--line);
  font-size: 0.95rem;
}

.status-row:last-child {
  border-bottom: none;
}

.status-row span,
.application-row span,
.panel-header span,
.panel-footer span,
.discord-header span {
  color: var(--muted);
}

.status-dot {
  width: 0.7rem;
  height: 0.7rem;
  border-radius: 50%;
  background: var(--red);
  box-shadow: 0 0 18px rgba(193, 18, 31, 0.9);
}

.section {
  padding: 4.5rem 0;
}

.alt {
  background: rgba(255, 255, 255, 0.01);
  border-top: 1px solid var(--line);
  border-bottom: 1px solid var(--line);
}

.section-heading {
  margin-bottom: 2rem;
  text-align: center;
}

.left-align {
  text-align: left;
}

.mission-grid,
.divisions-grid,
.leadership-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 1.25rem;
}

.mission-card,
.division-card,
.leader-card,
.application-card,
.discord-card,
.announcement-item,
.embed-form,
.embed-preview {
  background: rgba(20, 23, 27, 0.88);
  border: 1px solid var(--line);
  border-radius: 20px;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.18);
}

.mission-card,
.division-card,
.leader-card {
  padding: 1.5rem;
}

.division-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 54px;
  min-height: 54px;
  margin-bottom: 1rem;
  border-radius: 14px;
  background: linear-gradient(135deg, rgba(193, 18, 31, 0.2), rgba(193, 18, 31, 0.45));
  border: 1px solid rgba(193, 18, 31, 0.5);
  color: #ffdee0;
  font-weight: 800;
  letter-spacing: 0.08em;
}

.leader-role {
  display: inline-block;
  margin-bottom: 0.5rem;
  color: #ffb1a9;
  font-size: 0.76rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.recruitment-layout,
.discord-layout {
  display: grid;
  grid-template-columns: 1.15fr 0.85fr;
  gap: 1.5rem;
  align-items: center;
}

.check-list {
  margin: 1.5rem 0 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 0.8rem;
  color: var(--text);
}

.check-list li {
  position: relative;
  padding-left: 1.6rem;
}

.check-list li::before {
  content: "✓";
  position: absolute;
  left: 0;
  color: #ffb1a9;
  font-weight: 700;
}

.application-card {
  padding: 1.5rem;
}

.application-card h3 {
  margin-bottom: 1rem;
}

.application-row {
  padding: 0.9rem 0;
  border-bottom: 1px solid var(--line);
}

.application-card .btn {
  margin-top: 1rem;
}

.full-width {
  width: 100%;
}

.muted {
  color: var(--muted);
  font-size: 0.86rem;
}

.announcement-list {
  display: grid;
  gap: 1rem;
}

.announcement-item {
  display: grid;
  grid-template-columns: 120px 1fr;
  gap: 1rem;
  align-items: start;
  padding: 1.2rem 1.25rem;
}

.announcement-date {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 60px;
  padding: 0.7rem;
  border-radius: 14px;
  background: rgba(193, 18, 31, 0.12);
  border: 1px solid rgba(193, 18, 31, 0.4);
  color: #ffb1a9;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  font-size: 0.72rem;
}

.discord-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  margin-top: 1.5rem;
}

.discord-card {
  padding: 1.2rem;
}

.discord-header {
  align-items: center;
  justify-content: flex-start;
  margin-bottom: 1rem;
  gap: 0.8rem;
}

.discord-avatar {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 50px;
  height: 50px;
  border-radius: 50%;
  background: linear-gradient(135deg, #5865f2, #404eed);
  color: white;
  font-weight: 800;
  font-size: 0.8rem;
}

.discord-header strong {
  display: block;
}

.discord-body p {
  margin: 0 0 0.75rem;
  color: var(--muted);
}

.discord-body ul {
  margin: 0;
  padding-left: 1.3rem;
  color: var(--text);
}

.dashboard-section {
  padding-bottom: 5.5rem;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
}

.embed-form,
.embed-preview {
  padding: 1.25rem;
}

.embed-form {
  display: grid;
  gap: 1rem;
}

label {
  display: grid;
  gap: 0.45rem;
  font-weight: 600;
  color: var(--text);
}

input,
textarea {
  width: 100%;
  min-height: 46px;
  padding: 0.8rem 0.9rem;
  border-radius: 12px;
  border: 1px solid var(--line);
  background: rgba(12, 14, 17, 0.9);
  color: var(--text);
  font: inherit;
}

textarea {
  min-height: 110px;
  resize: vertical;
}

input[type="color"] {
  min-height: 48px;
  padding: 0.2rem;
}

.field-row {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1rem;
}

.embed-preview {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 420px;
}

.discord-embed {
  display: flex;
  width: min(100%, 460px);
  min-height: 290px;
  background: #2f3136;
  border-radius: 12px;
  color: #fff;
  overflow: hidden;
  border-left: 1px solid rgba(255, 255, 255, 0.12);
}

.embed-accent {
  width: 6px;
  background: var(--red-strong);
}

.embed-content {
  flex: 1;
  padding: 1rem 1rem 0.9rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.embed-author,
.embed-footer {
  color: #b9bbbe;
  font-size: 0.75rem;
}

.embed-title {
  font-weight: 700;
  font-size: 1.08rem;
  line-height: 1.3;
}

.embed-description {
  color: #dcddde;
  line-height: 1.5;
  font-size: 0.92rem;
}

.embed-field {
  margin-top: 0.25rem;
  padding: 0.7rem 0.8rem;
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.02);
  border: 1px solid rgba(255, 255, 255, 0.04);
}

.field-name {
  color: #ffffff;
  font-weight: 700;
  margin-bottom: 0.15rem;
}

.field-value {
  color: #dcddde;
  font-size: 0.85rem;
}

.site-footer {
  border-top: 1px solid var(--line);
  background: rgba(9, 11, 13, 0.9);
}

.footer-shell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 110px;
  gap: 1rem;
}

.footer-links {
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
  color: var(--muted);
}

@media (max-width: 920px) {
  .hero-grid,
  .recruitment-layout,
  .discord-layout,
  .dashboard-grid,
  .mission-grid,
  .divisions-grid,
  .leadership-grid {
    grid-template-columns: 1fr;
  }

  .nav {
    justify-content: flex-start;
    padding-bottom: 0.75rem;
  }

  .nav-shell {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding: 0.8rem 0;
  }

  .hero {
    padding-top: 3rem;
  }
}

@media (max-width: 640px) {
  .hero-stats {
    grid-template-columns: 1fr;
  }

  .field-row,
  .announcement-item {
    grid-template-columns: 1fr;
  }

  .announcement-item {
    display: flex;
    flex-direction: column;
  }

  .footer-shell {
    flex-direction: column;
    justify-content: center;
    text-align: center;
    padding: 1.25rem 0;
  }

  .site-footer {
    padding-bottom: 0.5rem;
  }
}
