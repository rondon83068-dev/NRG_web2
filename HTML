<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="National Register Guard emergency response agency website. Ready Today. Prepared for Tomorrow."
    />
    <title>National Register Guard | Ready Today. Prepared for Tomorrow.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <header class="topbar">
      <div class="container nav-shell">
        <a href="#home" class="brand" aria-label="National Register Guard home">
          <span class="brand-mark">NRG</span>
          <span class="brand-text">National Register Guard</span>
        </a>
        <nav class="nav" aria-label="Main navigation">
          <a href="#home">Home</a>
          <a href="#mission">Mission</a>
          <a href="#divisions">Divisions</a>
          <a href="#recruitment">Recruitment</a>
          <a href="#announcements">Announcements</a>
          <a href="#discord">Discord</a>
          <a href="#dashboard">Dashboard</a>
        </nav>
      </div>
    </header>

    <main id="home">
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <div class="eyebrow">Emergency Response Agency</div>
            <h1>National Register Guard</h1>
            <p class="tagline">Ready Today. Prepared for Tomorrow.</p>
            <p class="lead">
              NRG delivers disciplined response, coordinated command, and trained support
              for high-risk incidents, major events, and critical infrastructure operations.
            </p>
            <div class="cta-group">
              <a class="btn btn-primary" href="#recruitment">Join NRG</a>
              <a class="btn btn-secondary" href="#discord">Community Hub</a>
            </div>
            <ul class="hero-stats" aria-label="Agency stats">
              <li><strong>24/7</strong><span>Operational readiness</span></li>
              <li><strong>5</strong><span>Core divisions</span></li>
              <li><strong>100%</strong><span>Prepared response mindset</span></li>
            </ul>
          </div>

          <div class="hero-panel" aria-label="Operational overview card">
            <div class="panel-header">
              <span class="status-dot"></span>
              <span>Operations Status</span>
            </div>
            <div class="panel-body">
              <div class="status-row">
                <span>Readiness</span>
                <strong>Level 1</strong>
              </div>
              <div class="status-row">
                <span>Response Window</span>
                <strong>Immediate</strong>
              </div>
              <div class="status-row">
                <span>Mission Focus</span>
                <strong>Critical Response</strong>
              </div>
            </div>
            <div class="panel-footer">
              <span>Mission Command</span>
              <strong>NRG Headquarters</strong>
            </div>
          </div>
        </div>
      </section>

      <section id="mission" class="section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Our Mission</p>
            <h2>Prepared people. Professional response.</h2>
          </div>
          <div class="mission-grid">
            <article class="mission-card">
              <h3>Mission</h3>
              <p>
                NRG exists to support emergency operations, public safety, and crisis
                response through disciplined coordination, skilled field support, and rapid
                deployment capability.
              </p>
            </article>
            <article class="mission-card">
              <h3>Core Values</h3>
              <p>
                Readiness, accountability, professionalism, teamwork, and integrity guide
                every assignment and every training cycle.
              </p>
            </article>
            <article class="mission-card">
              <h3>Operational Scope</h3>
              <p>
                We coordinate response support for public safety operations, incident
                logistics, medical support, intelligence coordination, and administrative
                command structure.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section id="divisions" class="section alt">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Staff &amp; Divisions</p>
            <h2>Specialized teams for mission success.</h2>
          </div>

          <div class="divisions-grid">
            <article class="division-card">
              <div class="division-badge">RRT</div>
              <h3>Rapid Response Team</h3>
              <p>
                Fast-moving field capability focused on rapid deployment, first arrival
                operations, and emergency scene support.
              </p>
            </article>
            <article class="division-card">
              <div class="division-badge">MD</div>
              <h3>Medical Division</h3>
              <p>
                Medical readiness, casualty support, and emergency care coordination for
                high-stress incidents and large-scale events.
              </p>
            </article>
            <article class="division-card">
              <div class="division-badge">IID</div>
              <h3>Intelligence &amp; Investigations Division</h3>
              <p>
                Structured reporting, threat awareness, evidence coordination, and risk
                analysis support.
              </p>
            </article>
            <article class="division-card">
              <div class="division-badge">RD</div>
              <h3>Resource Division</h3>
              <p>
                Equipment readiness, supply tracking, logistics coordination, and response
                asset planning.
              </p>
            </article>
            <article class="division-card">
              <div class="division-badge">VAU</div>
              <h3>Volunteer &amp; Administrative Unit</h3>
              <p>
                Community engagement, member support, onboarding, documentation, and
                operational administration.
              </p>
            </article>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Leadership</p>
            <h2>Command structure placeholders</h2>
          </div>
          <div class="leadership-grid">
            <article class="leader-card">
              <span class="leader-role">Command Director</span>
              <h3>Placeholder Name</h3>
              <p>Leadership details are intentionally left as placeholders for future updates.</p>
            </article>
            <article class="leader-card">
              <span class="leader-role">Operations Chief</span>
              <h3>Placeholder Name</h3>
              <p>Leadership details are intentionally left as placeholders for future updates.</p>
            </article>
            <article class="leader-card">
              <span class="leader-role">Medical Lead</span>
              <h3>Placeholder Name</h3>
              <p>Leadership details are intentionally left as placeholders for future updates.</p>
            </article>
          </div>
        </div>
      </section>

      <section id="recruitment" class="section alt">
        <div class="container recruitment-layout">
          <div>
            <div class="section-heading left-align">
              <p class="eyebrow">Recruitment</p>
              <h2>Build with us. Serve with purpose.</h2>
            </div>
            <p class="section-copy">
              National Register Guard is seeking disciplined, motivated individuals who are
              ready to contribute to emergency response work, operational support, and
              community resilience.
            </p>
            <ul class="check-list">
              <li>Member intake and onboarding process</li>
              <li>Training readiness and role assignments</li>
              <li>Operations expectations and professionalism standards</li>
              <li>Background screening and compliance review</li>
            </ul>
          </div>

          <div class="application-card">
            <h3>Application Information</h3>
            <div class="application-row">
              <span>Application Stage</span>
              <strong>Open / Intake</strong>
            </div>
            <div class="application-row">
              <span>Review Process</span>
              <strong>Eligibility + Interview</strong>
            </div>
            <div class="application-row">
              <span>Minimum Expectations</span>
              <strong>Professional Conduct</strong>
            </div>
            <div class="application-row">
              <span>Documentation</span>
              <strong>Resume &amp; Interest Form</strong>
            </div>
            <a class="btn btn-primary full-width" href="#home">Submit Interest</a>
            <p class="muted">Replace this CTA with your application link or form when ready.</p>
          </div>
        </div>
      </section>

      <section id="announcements" class="section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Announcements</p>
            <h2>Latest updates from the agency.</h2>
          </div>
          <div class="announcement-list">
            <article class="announcement-item">
              <span class="announcement-date">Oct 24</span>
              <div>
                <h3>NRG website launch</h3>
                <p>
                  The National Register Guard website is now live and ready for public
                  information, recruitment, and operational updates.
                </p>
              </div>
            </article>
            <article class="announcement-item">
              <span class="announcement-date">Upcoming</span>
              <div>
                <h3>Training schedule update</h3>
                <p>
                  Additional coordination details and role-based training information will be
                  published in the next operational bulletin.
                </p>
              </div>
            </article>
            <article class="announcement-item">
              <span class="announcement-date">Pending</span>
              <div>
                <h3>Recruitment intake window</h3>
                <p>
                  The application cycle will open when leadership approves the next round of
                  member onboarding and screening.
                </p>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section id="discord" class="section alt">
        <div class="container discord-layout">
          <div class="discord-copy">
            <div class="section-heading left-align">
              <p class="eyebrow">Community</p>
              <h2>Discord server access</h2>
            </div>
            <p>
              Use the NRG Discord server as the primary communications and coordination hub for
              announcements, updates, and team discussions. Replace the sample invite with your
              organization’s real Discord link when available.
            </p>
            <div class="discord-actions">
              <a class="btn btn-primary" href="https://discord.gg/your-server" target="_blank" rel="noreferrer">Join Discord</a>
              <a class="btn btn-secondary" href="#dashboard">Embed Builder</a>
            </div>
          </div>

          <div class="discord-card">
            <div class="discord-header">
              <div class="discord-avatar">NRG</div>
              <div>
                <strong>National Register Guard</strong>
                <span>Server Community</span>
              </div>
            </div>
            <div class="discord-body">
              <p>Announcements</p>
              <ul>
                <li>#ops-updates</li>
                <li>#recruitment</li>
                <li>#training</li>
              </ul>
            </div>
          </div>
        </div>
      </section>

      <section id="dashboard" class="section dashboard-section">
        <div class="container">
          <div class="section-heading">
            <p class="eyebrow">Command Dashboard</p>
            <h2>Discord-style embed creator</h2>
          </div>
          <div class="dashboard-grid">
            <form class="embed-form" id="embedForm">
              <label>
                Title
                <input type="text" id="embedTitle" value="Mission Brief" />
              </label>
              <label>
                Description
                <textarea id="embedDescription">Operations are underway. Maintain readiness and follow command direction.</textarea>
              </label>
              <div class="field-row">
                <label>
                  Author
                  <input type="text" id="embedAuthor" value="NRG Command" />
                </label>
                <label>
                  Footer
                  <input type="text" id="embedFooter" value="Prepared for tomorrow" />
                </label>
              </div>
              <div class="field-row">
                <label>
                  Accent Color
                  <input type="color" id="embedColor" value="#c1121f" />
                </label>
                <label>
                  Timestamp
                  <input type="text" id="embedTimestamp" value="2026-10-24T18:30:00Z" />
                </label>
              </div>
              <label>
                Extra Field Name
                <input type="text" id="fieldName" value="Status" />
              </label>
              <label>
                Extra Field Value
                <input type="text" id="fieldValue" value="Full Response / Ready" />
              </label>
              <button type="submit" class="btn btn-primary full-width">Refresh Preview</button>
            </form>

            <div class="embed-preview" aria-live="polite">
              <div class="discord-embed" id="discordEmbed">
                <div class="embed-accent" id="embedAccent"></div>
                <div class="embed-content">
                  <div class="embed-author" id="previewAuthor">NRG Command</div>
                  <div class="embed-title" id="previewTitle">Mission Brief</div>
                  <div class="embed-description" id="previewDescription">
                    Operations are underway. Maintain readiness and follow command direction.
                  </div>
                  <div class="embed-field">
                    <div class="field-name" id="previewFieldName">Status</div>
                    <div class="field-value" id="previewFieldValue">Full Response / Ready</div>
                  </div>
                  <div class="embed-footer" id="previewFooter">Prepared for tomorrow</div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-shell">
        <div>
          <strong>National Register Guard</strong>
          <p>Ready Today. Prepared for Tomorrow.</p>
        </div>
        <div class="footer-links">
          <a href="#mission">Mission</a>
          <a href="#divisions">Divisions</a>
          <a href="#recruitment">Recruitment</a>
          <a href="#discord">Discord</a>
        </div>
      </div>
    </footer>

    <script src="script.js"></script>
  </body>
</html>
